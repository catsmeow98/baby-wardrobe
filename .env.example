# Supabase project settings: Dashboard > Project Settings > API.
# The anon (publishable) key is safe in the browser because row-level security protects the data.
# Never put the service-role key in this app or in any NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Used to build links in confirmation and reset emails when running locally or on a preview.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
